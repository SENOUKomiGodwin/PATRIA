# Configuration de l'environnement
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# PostgreSQL
POSTGRES_USER=patrimoine_user
POSTGRES_PASSWORD=change_this_password_in_production
POSTGRES_PORT=5432

# JWT Secret (PARTAGÉ ENTRE TOUS LES SERVICES)
JWT_SECRET=change_this_jwt_secret_in_production_minimum_32_characters
JWT_TTL=480

# Clé de chiffrement propre au frontend (sessions/cache)
FRONTEND_APP_KEY=

# Mode démo : true = login sans vérification (développement uniquement)
DEMO_MODE=false

# Origines autorisées pour les appels API cross-origin (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost

# Ports
GATEWAY_PORT=80
FRONTEND_PORT=3000
