<mxCell id="m11" value="11. Confirmation affichée" style="html=1;verticalAlign=bottom;fontSize=10;labelBackgroundColor=#ffffff;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="540" as="sourcePoint"/><mxPoint x="100" y="540" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="n" value="Clôture : PATCH /api/interventions/{id}/close (coût, rapport) → même schéma, le bien repasse EN_SERVICE.&lt;br&gt;Préventif : la commande planifiée maintenance:check-due crée les interventions PLANIFIEE échues." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="700" height="50" as="geometry"/></mxCell>
