# Environment
.env

# Docker volumes
postgres_data/

# Laravel services - ignore generated files, keep Dockerfiles
services/*/vendor/
services/*/node_modules/
services/*/storage/*/
services/*/public/storage/
services/*/public/hot
services/*/public/build
services/*/.env
services/*/.env.example
services/*/.env.backup
services/*/.phpunit.result.cache
services/*/.idea
services/*/.vscode
services/*/*.log
services*/bootstrap/cache/
services*/database/*.sqlite
services*/database/database.sqlite

# Frontend - ignore generated files, keep Dockerfile
frontend/vendor/
frontend/node_modules/
frontend/storage/*/
frontend/public/storage/
frontend/public/hot
frontend/public/build
frontend/.env
frontend/.env.example
frontend/.env.backup
frontend/.phpunit.result.cache
frontend/.idea
frontend/.vscode
frontend/*.log
frontend/bootstrap/cache/
frontend/database/*.sqlite
frontend/database/database.sqlite

# Keep Dockerfiles, entrypoint scripts, and storage .gitkeep files
!services/*/Dockerfile
!services/*/entrypoint.sh
!services/*/storage/
!frontend/Dockerfile
!frontend/storage/
